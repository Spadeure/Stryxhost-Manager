<Window x:Class="DayZServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:DayZServerManager.Themes"
        Title="Stryxhost Manager"
        Width="1280" Height="800" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Barre de titre ===== -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="STRYXHOST MANAGER" FontFamily="{StaticResource Orbitron}" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Le gestionnaire de serveurs DayZ" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" Margin="12,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeButton}" ToolTip="Réduire" Click="Minimize_Click">
                            <Path Data="M0,5 L10,5" StrokeThickness="1.2" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" ToolTip="Agrandir" Click="Maximize_Click">
                            <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" StrokeThickness="1.2" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" ToolTip="Fermer" Click="Close_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MenuColumn" Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Menu latéral ===== -->
                <Border x:Name="MenuBorder" Grid.Column="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,14">
                    <DockPanel>
                        <!-- Version : s'allume quand une mise à jour est disponible -->
                        <Button x:Name="VersionButton" DockPanel.Dock="Bottom" Margin="0,4,0,0" Style="{StaticResource VersionButton}"
                                ToolTip="Mises à jour de l'application" Click="Version_Click">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="BuildText" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0"
                                           Foreground="{StaticResource CyanBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- ⚙ Paramètres : tout ce qui se règle une fois -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <RadioButton x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="Paramètres" Tag="settings"
                                         Checked="Nav_Checked"
                                         nav:NavProps.Icon="M12 15a3 3 0 1 0 0-6a3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33a1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                        </Border>

                        <!-- Bouton pour réduire / agrandir le menu -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button x:Name="CollapseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    ToolTip="Réduire le menu" Click="Collapse_Click" HorizontalAlignment="Right">
                                <Path x:Name="CollapseIcon" Data="M10 3L5 8L10 13" StrokeThickness="1.6" Width="16" Height="16"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Border />
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,12">
                            <StackPanel x:Name="NavPanel">
                                <TextBlock Style="{StaticResource NavHeader}" Text="SERVEUR" />
                                <RadioButton x:Name="DashboardNav" Style="{StaticResource NavButton}" Content="Tableau de bord" Tag="dashboard"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M3 13h8V3H3zM13 21h8V11h-8zM3 21h8v-6H3zM13 9h8V3h-8z" />
                                <RadioButton x:Name="PlayersNav" Style="{StaticResource NavButton}" Content="Joueurs" Tag="players"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8a4 4 0 1 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                                <RadioButton Style="{StaticResource NavButton}" Content="Journaux" Tag="logs"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8" />

                                <RadioButton Style="{StaticResource NavButton}" Content="Sauvegardes" Tag="backups"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M21 8v13H3V8M1 3h22v5H1zM10 12h4" />

                                <TextBlock Style="{StaticResource NavHeader}" Text="CONTENU" />
                                <RadioButton Style="{StaticResource NavButton}" Content="Mods" Tag="mods"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16zM3.3 7L12 12L20.7 7M12 22V12" />
                                <RadioButton x:Name="LootNav" Style="{StaticResource NavButton}" Content="Loot" Tag="loot"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M6 3h12l3 6l-9 12L3 9z M3 9h18 M9 3l3 6l3-6 M12 9v12" />
                                <RadioButton x:Name="EconomyNav" Style="{StaticResource NavButton}" Content="Économie" Tag="economy"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                <RadioButton x:Name="XmlNav" Style="{StaticResource NavButton}" Content="Éditeur XML" Tag="xml"
                                             Checked="Nav_Checked" nav:NavProps.Icon="M16 18l6-6l-6-6M8 6l-6 6l6 6" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Contenu de la page ===== -->
                <ContentControl x:Name="PageHost" Grid.Column="1" Margin="32,28" />
            </Grid>
        </Grid>
    </Border>
</Window>
