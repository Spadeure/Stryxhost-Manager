<UserControl x:Class="DayZServerManager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock x:Name="TitleText" Text="LANCEMENT" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" FontSize="14" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />

            <!-- ===== Langue (Application) ===== -->
            <Border x:Name="LanguageCard" Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="LANGUE" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,16,0,0">
                        <RadioButton Content="Français" GroupName="lang" IsChecked="True" Style="{StaticResource ChipButton}" />
                        <RadioButton Content="English (bientôt)" GroupName="lang" IsEnabled="False" Style="{StaticResource ChipButton}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="L'application n'existe qu'en français pour l'instant. L'anglais arrivera dans une prochaine mise à jour." />
                </StackPanel>
            </Border>

            <!-- ===== Redémarrages et lancement (Lancement) ===== -->
            <Border x:Name="RestartCard" Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="REDÉMARRAGES ET LANCEMENT" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutoStartServerToggle" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0"
                              Content="Démarrer le serveur automatiquement à l'ouverture de l'application"
                              Click="Options_Changed" />
                    <CheckBox x:Name="AutoRestartToggle" Content="Redémarrer le serveur tout seul en cas de crash"
                              Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="Options_Changed" />
                    <CheckBox x:Name="ScheduledToggle" Content="Redémarrage programmé"
                              Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="Options_Changed" />
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Toutes les" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="HoursBox" Style="{StaticResource NumberBox}" Width="70" MaxLength="2" Margin="10,0"
                                 LostFocus="Options_Changed" />
                        <TextBlock Text="heures" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                    <CheckBox x:Name="WarnToggle" Content="Prévenir les joueurs 10, 5 et 1 min avant un redémarrage programmé"
                              Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="Options_Changed" />
                    <TextBlock Text="Les redémarrages automatiques fonctionnent tant que l'application est ouverte (ou réduite près de l'horloge)."
                               Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right" Content="Paramètres de lancement" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Margin="16,0,0,0" Click="LaunchSettings_Click" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center"
                                   Text="La ligne de commande du serveur : paramètres supplémentaires, ligne personnalisée, mods ajoutés à la main." />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Démarrage (Application) ===== -->
            <Border x:Name="StartupCard" Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="DÉMARRAGE" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="StartWithWindowsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0"
                              Content="Lancer Stryxhost Manager à l'ouverture de Windows (réduit près de l'horloge)"
                              Click="StartWithWindows_Click" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                               Text="Avec « Démarrer le serveur automatiquement » (rubrique Lancement), ton serveur redémarre tout seul même après un redémarrage du PC." />
                </StackPanel>
            </Border>

            <!-- ===== Zone de notification (Application) ===== -->
            <Border x:Name="TrayCard" Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="ZONE DE NOTIFICATION" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="CloseToTrayToggle" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0"
                              Content="Le bouton Fermer réduit l'application près de l'horloge au lieu de la quitter"
                              Click="Options_Changed" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                               Text="L'application continue alors de surveiller le serveur (crash, redémarrages, mises à jour). Pour la quitter vraiment : clic droit sur son icône près de l'horloge, puis « Quitter »." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" Margin="0,16,0,8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
