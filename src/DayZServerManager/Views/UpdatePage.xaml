<UserControl x:Class="DayZServerManager.Views.UpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MISES À JOUR" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Le serveur DayZ et Stryxhost Manager." FontSize="14"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Serveur DayZ ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SERVEUR DAYZ" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,14,0,0">
                        <RadioButton x:Name="StableChip" Content="Stable" GroupName="branch" Style="{StaticResource ChipButton}"
                                     Click="Branch_Click" />
                        <RadioButton x:Name="ExperimentalChip" Content="Expérimentale" GroupName="branch"
                                     Style="{StaticResource ChipButton}" Click="Branch_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="BranchInfo" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    <CheckBox x:Name="AutoUpdateServerToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"
                              Content="Mettre à jour le serveur automatiquement" Click="ServerOptions_Changed"
                              ToolTip="À chaque démarrage, et une vérification toutes les 30 minutes : si Bohemia sort une mise à jour, les joueurs sont prévenus et le serveur redémarre 5 minutes plus tard pour l'installer." />
                    <CheckBox x:Name="AutoUpdateModsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"
                              Content="Mettre à jour les mods à chaque démarrage" Click="ServerOptions_Changed"
                              ToolTip="Seuls les mods qui ont changé sont recopiés, pour que le démarrage reste rapide." />
                    <TextBlock x:Name="ServerStatusText" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Application ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="STRYXHOST MANAGER" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="INSTALLÉE" FontSize="11" FontWeight="SemiBold" Foreground="#7D7699" />
                            <TextBlock x:Name="CurrentText" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                            <TextBlock x:Name="CurrentKind" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DERNIÈRE VERSION" FontSize="11" FontWeight="SemiBold" Foreground="#7D7699" />
                            <TextBlock x:Name="LatestText" Text="…" FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Text="Vérification en cours…" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PATCH NOTES" Style="{StaticResource SectionTitle}" />

                <Border Grid.Row="1" Background="{StaticResource ConsoleBrush}" CornerRadius="10" Padding="20,16"
                        Margin="0,16,0,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NotesPanel" />
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="DownloadPanel" Grid.Row="2" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="DownloadText" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <ProgressBar x:Name="DownloadBar" Style="{StaticResource NeonProgress}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CheckButton" Content="Vérifier" Style="{StaticResource SecondaryButton}"
                            Click="Check_Click" />
                    <Button x:Name="UpdateButton" Content="Mettre à jour" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" IsEnabled="False" Click="Update_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
